# ---- Koneksi database ----
# Aplikasi terhubung memakai role terbatas (RLS berlaku).
# Supabase: gunakan connection string "Connection pooling / Transaction" untuk DATABASE_URL.
DATABASE_URL=postgres://misi_app:ganti-password@127.0.0.1:5433/misi_pintar

# Hanya dipakai script migrasi & seed (boleh owner database).
# Supabase: service role / direct connection. JANGAN pernah dipakai di runtime aplikasi.
ADMIN_DATABASE_URL=postgres://postgres:ganti-password@127.0.0.1:5433/misi_pintar

# URL publik aplikasi (dipakai untuk metadata & tautan absolut).
APP_URL=http://localhost:3000

# ---- Akun demo (dipakai oleh `npm run db:seed`) ----
# Ganti sebelum deploy. Seed menolak membuat akun demo bila NODE_ENV=production
# dan SEED_DEMO_ACCOUNTS bukan "true".
SEED_TEACHER_EMAIL=guru@misipintar.test
SEED_TEACHER_PASSWORD=GuruMisi2026!
SEED_DEMO_ACCOUNTS=false
