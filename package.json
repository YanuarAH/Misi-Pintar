{
  "name": "misi-pintar",
  "version": "0.1.0",
  "private": true,
  "description": "Misi Pintar - platform belajar interaktif untuk siswa kelas 5-6 SD",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/migrate.ts --reset && tsx scripts/seed.ts",
    "db:cleanup": "tsx scripts/cleanup.ts",
    "db:audit-kurikulum": "tsx scripts/audit-kurikulum.ts",
    "db:start": "tsx scripts/dev-db.ts start",
    "db:stop": "tsx scripts/dev-db.ts stop",
    "test": "vitest run",
    "test:http": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
